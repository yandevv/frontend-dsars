# Base das chamadas à API. Com o proxy do Vite (desenvolvimento) ou com um
# proxy reverso no mesmo domínio (produção), basta `/api`.
VITE_API_BASE=/api

# Slug da organização controladora atendida por este portal
# (GET /public/organizations/:slug).
VITE_ORGANIZATION_SLUG=demonstracao

# Só para o `vite dev`/`vite preview`: para onde o proxy encaminha `/api`.
# API_PROXY_TARGET=http://localhost:3000
